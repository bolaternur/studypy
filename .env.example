# Ключ Google Gemini. Нужен только для ИИ-наставника и генерации ежедневных
# задач. Читает его исключительно сервер — в браузер он никогда не попадает.
# Без ключа эти функции отключаются, остальное приложение работает.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Публичный адрес, на котором развёрнуто приложение. Используется для
# самоссылок и как источник разрешённых origin, если CORS_ORIGINS не задан.
APP_URL="http://localhost:3000"

# ID проекта Firebase, чьи ID-токены проверяет сервер. Должен совпадать с
# проектом из firebase-applet-config.json.
FIREBASE_PROJECT_ID="pyquest-animcin84-2026"

# Service account Firebase в виде JSON-строки. Включает Admin SDK и вместе с
# ним доверенные серверные транзакции: начисление опыта, монет и предметов.
# Без него соответствующие эндпоинты отвечают 503.
# НИКОГДА не коммитьте реальное значение и не отдавайте его в браузер.
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'

# Список origin через запятую, которым разрешено подключаться к серверу и
# Socket.IO. В production обязателен.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Часовой пояс, по которому определяется граница суток для ежедневных задач.
APP_TIME_ZONE="Asia/Almaty"

PORT="3000"
HOST="127.0.0.1"

    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-lessons.ts",
    "test:runtime": "tsx scripts/test-python-runtime.ts",
    "test:games": "tsx scripts/test-games.ts",
    "test:policy": "tsx scripts/test-result-policy.ts",
    "test": "npm run test:runtime && npm run test:content && npm run test:games && npm run test:policy && npm run test:storage && npm run test:dialogs && npm run test:sounds && npm run test:typing && npm run test:typing-levels && npm run test:mentor",
    "test:dialogs": "tsx scripts/test-scroll-lock.ts",
    "test:content": "tsx scripts/test-content.ts",
    "test:storage": "tsx scripts/test-storage.ts",
    "test:sounds": "tsx scripts/test-sounds.ts",
    "test:typing": "tsx scripts/test-typing.ts",
    "test:mentor": "tsx scripts/test-mentor-knowledge.ts",
    "test:typing-levels": "tsx scripts/test-typing-levels.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@monaco-editor/react": "^4.7.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.11.0",
    "firebase-admin": "^14.0.0",
    "lenis": "^1.3.19",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.13.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
